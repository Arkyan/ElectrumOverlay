{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ElectrumOverlay",
  "identifier": "com.electrumvtc.overlay",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../public/": "public/",
      "../src/templates/": "templates/"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "languages": [
          "French"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxRDRFMjExMzQ3RTgxNTcKUldSWGdYNDBFZUxVVVRldmFJZEYrMnlWeHk1K01TaU9CbW5WZTJYR2g3Q3NVWnR6MzZwNmp3UGQK",
      "endpoints": [
        "https://github.com/Arkyan/ElectrumOverlay/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
