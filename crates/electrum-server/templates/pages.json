  "setup": {
    "source": "src/routes/setup.js",
    "expressions": [
      "port",
      "esc(config.twitch.CLIENT_ID)",
      "config.twitch.CLIENT_SECRET ? 'Déjà enregistré — laisser vide pour ne pas changer' : ''",
      "esc(config.twitch.BROADCASTER_LOGIN ? '@' + config.twitch.BROADCASTER_LOGIN + ' — ID ' + config.twitch.BROADCASTER_ID : (config.twitch.BROADCASTER_ID || 'Aucune — autorisez d\\'abord'))",
      "esc(accentDefault)",
      "esc(bottom.infoTexts?.[0] || '')",
      "esc(bottom.infoTexts?.[1] || '')",
      "esc(bottom.infoTexts?.[2] || '')",
      "esc(bottom.scrollingText || '')",
      "config.ngrok.ENABLED ? 'checked' : ''",
      "config.ngrok.AUTHTOKEN ? 'Déjà enregistré — laisser vide pour ne pas changer' : ''"
    ]
  },
  "app": {
