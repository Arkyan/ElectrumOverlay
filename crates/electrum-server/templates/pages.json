  "commands": {
    "source": "src/routes/commands.js",
    "expressions": [
      "commandCardHTML({ id: 'new', trigger: '', enabled: true, permission: 'everyone', cooldownSeconds: 5, chatReply: { enabled: false, message: '' }, overlayAction: { enabled: false, panel: 'left' } }, true)",
      "commands.length ? commands.map((c) => commandCardHTML(c, false)).join('') : '<p class=\"hint\">Aucune commande pour le moment.</p>'"
    ]
  },
  "command-card": {
    "source": "src/routes/commands.js",
    "expressions": [
      "esc(id)",
      "openByDefault ? 'open' : ''",
      "isNew ? '+ Nouvelle commande' : (esc(command.trigger) || '(sans déclencheur)')",
      "tags",
      "esc(command.trigger)",
      "Object.entries(PERMISSION_LABELS).map(([value, label]) =>\n                            `<option value=\"${value}\" ${command.permission === value ? 'selected' : ''}>${label}</option>`\n                        ).join('')",
      "esc(command.cooldownSeconds)",
      "command.enabled ? 'checked' : ''",
      "command.chatReply?.enabled ? 'checked' : ''",
      "esc(command.chatReply?.message || '')",
      "command.overlayAction?.enabled ? 'checked' : ''",
      "command.overlayAction?.panel !== 'bottom' ? 'selected' : ''",
      "command.overlayAction?.panel === 'bottom' ? 'selected' : ''"
    ]
  },
  "integrations": {
    "source": "src/routes/integrations.js",
    "expressions": [
      "error ? `<p class=\"msg error\">${esc(error)}</p>` : ''",
      "justConnected ? `<p class=\"msg success\">Compte Spotify connecté.</p>` : ''",
      "esc(redirectUri)",
      "esc(clientId)",
      "esc(clientSecret)",
      "connected ? `\n                            <div class=\"status-pill\" style=\"margin-bottom: var(--space-3);\"><span class=\"dot\"></span> Connecté</div>\n                            <div class=\"spotify-now-playing\" id=\"nowPlaying\" style=\"display:none;\">\n                                <img id=\"npArt\" alt=\"\">\n                                <div>\n                                    <div class=\"np-title\" id=\"npTitle\"></div>\n                                    <div class=\"np-artist\" id=\"npArtist\"></div>\n                                </div>\n                            </div>\n                            <p class=\"hint\" id=\"npHint\">Rien en cours de lecture pour le moment.</p>\n                            <button type=\"button\" class=\"btn btn-danger\" id=\"btnDisconnect\" style=\"margin-top: var(--space-3);\">Déconnecter</button>\n                        ` : configured ? `\n                            <p class=\"hint\">Application enregistrée — connecte ton compte Spotify.</p>\n                            <a href=\"${esc(authUrl)}\" class=\"btn btn-primary\">Se connecter à Spotify</a>\n                        ` : `\n                            <p class=\"hint\">Renseigne d'abord le Client ID et le Client Secret ci-dessus.</p>\n                            <button type=\"button\" class=\"btn\" disabled>Se connecter à Spotify</button>\n                        `",
      "truckyEnabled ? 'checked' : ''",
      "esc(truckyUserId || '')",
      "inputDisplayEnabled ? 'checked' : ''"
    ]
  },
  "integrations-connected": {
    "source": "src/routes/integrations.js",
    "expressions": []
