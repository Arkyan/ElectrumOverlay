      "key",
      "esc(a.defaultMessage || '')",
      "key",
      "key",
      "ANIMATION_STYLES.map((s) => `<option value=\"${s.key}\" ${s.key === currentAnim ? 'selected' : ''}>${esc(s.label)}</option>`).join('')",
      "key",
      "key",
      "esc(a.border || '#8b45f6')",
      "key",
      "key",
      "esc(a.gradientStart || a.border || '#8b45f6')",
      "key",
      "key",
      "esc(a.gradientEnd || a.border || '#8b45f6')",
      "key",
